diff --git a/src/tone_stack.h b/src/tone_stack.h
new file mode 100644
index 0000000..87a6a85
--- /dev/null
+++ b/src/tone_stack.h
@@ -0,0 +1,176 @@
+#pragma once
+
+// Bass / Middle / Treble tone stack, ported from the NAM desktop plugin
+// (NeuralAmpModelerPlugin, NeuralAmpModeler/ToneStack.cpp, MIT licence,
+// Copyright (c) 2022 Steven Atkinson), with the biquads of AudioDSPTools
+// (dsp/RecursiveLinearFilter.cpp). Each knob goes 0 to 10, and 5 is flat.
+//
+// Bass:   low shelf at 150 Hz, Q 0.707, +/-20 dB
+// Middle: peaking at 425 Hz, +/-15 dB, Q 1.5 when cutting and 0.7 when boosting
+// Treble: high shelf at 1800 Hz, Q 0.707, +/-10 dB
+
+#include <cmath>
+#include <cstdint>
+
+namespace NAM {
+	class Biquad {
+	public:
+		enum Type { LowShelf, Peaking, HighShelf };
+
+		void set(Type type, double sampleRate, double frequency, double quality, double gainDB) noexcept
+		{
+			const double a = pow(10.0, gainDB / 40.0);
+			const double omega0 = 2.0 * M_PI * frequency / sampleRate;
+			const double alpha = sin(omega0) / (2.0 * quality);
+			const double cosw = cos(omega0);
+
+			double a0, a1, a2, b0, b1, b2;
+
+			switch (type)
+			{
+				case LowShelf:
+				{
+					const double ap = a + 1.0;
+					const double am = a - 1.0;
+					const double roota2alpha = 2.0 * sqrt(a) * alpha;
+
+					b0 = a * (ap - am * cosw + roota2alpha);
+					b1 = 2.0 * a * (am - ap * cosw);
+					b2 = a * (ap - am * cosw - roota2alpha);
+					a0 = ap + am * cosw + roota2alpha;
+					a1 = -2.0 * (am + ap * cosw);
+					a2 = ap + am * cosw - roota2alpha;
+					break;
+				}
+				case Peaking:
+				{
+					b0 = 1.0 + alpha * a;
+					b1 = -2.0 * cosw;
+					b2 = 1.0 - alpha * a;
+					a0 = 1.0 + alpha / a;
+					a1 = -2.0 * cosw;
+					a2 = 1.0 - alpha / a;
+					break;
+				}
+				default: // HighShelf
+				{
+					const double ap = a + 1.0;
+					const double am = a - 1.0;
+					const double roota2alpha = 2.0 * sqrt(a) * alpha;
+
+					b0 = a * (ap + am * cosw + roota2alpha);
+					b1 = -2.0 * a * (am + ap * cosw);
+					b2 = a * (ap + am * cosw - roota2alpha);
+					a0 = ap - am * cosw + roota2alpha;
+					a1 = 2.0 * (am - ap * cosw);
+					a2 = ap - am * cosw - roota2alpha;
+					break;
+				}
+			}
+
+			this->b0 = b0 / a0;
+			this->b1 = b1 / a0;
+			this->b2 = b2 / a0;
+			this->a1 = a1 / a0;
+			this->a2 = a2 / a0;
+		}
+
+		void reset() noexcept
+		{
+			x1 = x2 = y1 = y2 = 0;
+		}
+
+		// Direct form I, like AudioDSPTools
+		void process(float* buffer, uint32_t n_samples) noexcept
+		{
+			for (uint32_t i = 0; i < n_samples; i++)
+			{
+				const double x = buffer[i];
+				const double y = (b0 * x) + (b1 * x1) + (b2 * x2) - (a1 * y1) - (a2 * y2);
+
+				x2 = x1;
+				x1 = x;
+				y2 = y1;
+				y1 = y;
+
+				buffer[i] = (float)y;
+			}
+		}
+
+	private:
+		double b0 = 1, b1 = 0, b2 = 0, a1 = 0, a2 = 0;
+		double x1 = 0, x2 = 0, y1 = 0, y2 = 0;
+	};
+
+	class ToneStack {
+	public:
+		void set_sample_rate(double rate) noexcept
+		{
+			sampleRate = rate;
+
+			// force the filters to be recomputed for the new rate
+			bassVal = middleVal = trebleVal = -1;
+		}
+
+		void reset() noexcept
+		{
+			bass.reset();
+			middle.reset();
+			treble.reset();
+		}
+
+		void process(float* buffer, uint32_t n_samples, float bassIn, float middleIn, float trebleIn) noexcept
+		{
+			if (bassIn != bassVal)
+			{
+				bassVal = bassIn;
+				bass.set(Biquad::LowShelf, sampleRate, 150.0, 0.707, 4.0 * (bassVal - 5.0));
+			}
+
+			if (middleIn != middleVal)
+			{
+				middleVal = middleIn;
+
+				const double midGainDB = 3.0 * (middleVal - 5.0);
+
+				// Wider EQ on mid bump up to sound less honky.
+				middle.set(Biquad::Peaking, sampleRate, 425.0, midGainDB < 0.0 ? 1.5 : 0.7, midGainDB);
+			}
+
+			if (trebleIn != trebleVal)
+			{
+				trebleVal = trebleIn;
+				treble.set(Biquad::HighShelf, sampleRate, 1800.0, 0.707, 2.0 * (trebleVal - 5.0));
+			}
+
+			// All three knobs at 5 is flat: skip the filters
+			if ((bassVal == 5.0f) && (middleVal == 5.0f) && (trebleVal == 5.0f))
+			{
+				if (!flat)
+				{
+					reset();
+					flat = true;
+				}
+
+				return;
+			}
+
+			flat = false;
+
+			bass.process(buffer, n_samples);
+			middle.process(buffer, n_samples);
+			treble.process(buffer, n_samples);
+		}
+
+	private:
+		double sampleRate = 48000;
+		float bassVal = -1;
+		float middleVal = -1;
+		float trebleVal = -1;
+		bool flat = false;
+
+		Biquad bass;
+		Biquad middle;
+		Biquad treble;
+	};
+}
